# YouCam API (https://yce.perfectcorp.com/ai-api) – v2 endpoints use the API key as a Bearer token
YOUCAM_API_KEY=sk-...
YOUCAM_BASE_URL=https://yce-api-01.makeupar.com
# Gemini – comma-separated keys are used round-robin with failover on rate limits
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-3.5-flash
